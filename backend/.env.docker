# ============================================
# ENV FILE PARA DOCKER COMPOSE - PLATAFORMA MEH
# ============================================
# Este archivo se inyecta al contenedor via env_file en docker-compose.yml
# Las variables son leídas por os.getenv() en el backend
# NO es necesario load_dotenv() — Docker inyecta las vars directamente
# ============================================

# BASE DE DATOS
# La URL usa "db" como hostname (nombre del servicio PostgreSQL en docker-compose)
DATABASE_URL=postgresql://postgres:password123@db:5432/plataforma_meh

# PUERTO DEL SERVIDOR UVICORN
PORT=8000

# AUTENTICACIÓN JWT
# NOTA: En despliegue de producción real, SECRET_KEY DEBE suministrarse como variable
# de entorno del host o secret store (ej: openssl rand -hex 32).
# En entornos locales/dev sin SECRET_KEY, el sistema usa una clave de fallback con advertencia.
# SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=60

# ============================================
# CONFIGURACIÓN DE CORREOS ELECTRÓNICOS
# ============================================
# En despliegue real, configurar las credenciales SMTP válidas.
# Si se dejan vacíos, el sistema inicia sin SMTP y en modo desarrollo loguea las URLs de reset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=meh.bolivia@gmail.com
SMTP_PASSWORD=npftvdssqhkgvovi
EMAIL_FROM_NAME=Plataforma MEH

# ============================================
# URLS DEL FRONTEND
# ============================================
# Con el reverse proxy nginx, el frontend está en el mismo origen
FRONTEND_URL=https://plataforma-meh.runa.laotrared.net
FRONTEND_DASHBOARD=/dashboard
FRONTEND_LEARNING=/learning
FRONTEND_FINANZAS=/finanzas

# ============================================
# OAUTH / AUTENTICACIÓN SOCIAL
# ============================================
# Dejar vacío si no se usa Google OAuth (se desactiva automáticamente)
GOOGLE_CLIENT_ID=


# ============================================
# LIMPIEZA SELECTIVA DE DATOS (MEH-020)
# ============================================
ENABLE_DATA_CLEANUP=true
SUPERADMIN_EMAIL=natalygemio@gmail.com
CLEANUP_BACKUP_TTL_MINUTES=30
